# Select exactly one provider: duffel or travelport. Restart after changing.
# Both adapters currently use TEST / PRE-PRODUCTION only.
# Server-only credentials. Never use a NEXT_PUBLIC_ prefix.
FLIGHTS_PROVIDER=duffel

DUFFEL_ACCESS_TOKEN=

TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
TRAVELPORT_USERNAME=
TRAVELPORT_PASSWORD=
# Include the GDS suffix from your account, e.g. ABCD_1G.
TRAVELPORT_PCC=
TRAVELPORT_CONTENT_SOURCES=GDS,NDC

# Local TestSprite MCP UI testing. Never expose this to browser code.
TESTSPRITE_API_KEY=
